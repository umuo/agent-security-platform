# local 支持 SQLite；production 强制 PostgreSQL、HTTPS cookie 和显式密钥。
AGENTSEC_MODE=local
# 生产必填，HTTPS 公开地址，不含路径；反向代理后的 Origin 校验使用此配置。
AGENTSEC_PUBLIC_ORIGIN=
AGENTSEC_DATABASE_URL=sqlite:///data/platform.db
AGENTSEC_DATA_DIR=data
AGENTSEC_BIND=127.0.0.1
AGENTSEC_PORT=8088
# production：用 agentsec generate-key 生成，不提交真实密钥。
AGENTSEC_MASTER_KEY=
# 允许评测的固定主机列表；私网/回环地址也必须明确列出。
AGENTSEC_TARGET_HOSTS=
AGENTSEC_COOKIE_SECURE=false
AGENTSEC_SESSION_HOURS=8
AGENTSEC_LEASE_SECONDS=30
# 可选，只读使用现有 SDK 制品，不执行用户提供的任意命令。
AGENTSEC_SDK_REPO=
# observed-v1：独立业务观测服务。端点也须列入 TARGET_HOSTS，生产要求 HTTPS。
# 凭据文件只供 API/Worker 读取，不发送给被测 Agent；两项须一起配置。
AGENTSEC_OBSERVER_ENDPOINT=
AGENTSEC_OBSERVER_TOKEN_FILE=
